# NVIDIA GPU image: training (torchrun DDP), continual-learning worker, fast LLM inference
FROM pytorch/pytorch:2.4.1-cuda12.4-cudnn9-runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    AUTOLEARN_DATA_DIR=/data AUTOLEARN_LLM_DIR=/models/llm AUTOLEARN_OPEN_MODELS_DIR=/models/open
WORKDIR /app
COPY requirements.txt .
RUN grep -v '^torch==' requirements.txt > /tmp/req.txt && pip install -r /tmp/req.txt
COPY autolearn ./autolearn
EXPOSE 8000
CMD ["uvicorn", "autolearn.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
